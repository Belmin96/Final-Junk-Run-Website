// Junk Run — database schema
// Customer-side models for auth, job posting, estimates, payments, and reviews.
// Run `npm run db:push` after setting DATABASE_URL to create these tables in Neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  DRAFT // customer is still filling out the job post
  AWAITING_ESTIMATES // posted, waiting on contractor estimates
  ESTIMATES_RECEIVED // at least one estimate has come in
  CONTRACTOR_SELECTED // customer picked a contractor
  IN_PROGRESS // job accepted by contractor, work not yet done
  COMPLETED // work done, ready for payment/review
  CANCELLED
}

enum EstimateStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// A signed-in customer. One row per Clerk user (linked by clerkId).
model Customer {
  id                     String   @id @default(cuid())
  clerkId                String   @unique
  email                  String   @unique
  firstName              String?
  lastName               String?
  phone                  String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  state                  String?
  zip                    String?
  stripeCustomerId       String?  @unique
  defaultPaymentMethodId String?
  // Cached for display only (avoids a Stripe API round-trip on every page
  // load) -- the source of truth is always Stripe.
  defaultPaymentMethodBrand String?
  defaultPaymentMethodLast4 String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  jobs    Job[]
  reviews Review[]
}

// Independent contractors. One row per Clerk user (linked by clerkId),
// same lazy-upsert pattern as Customer -- see lib/getOrCreateContractor.ts.
model Contractor {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  businessName String
  email        String   @unique
  phone        String?
  avgRating    Float?
  createdAt    DateTime @default(now())

  estimates        Estimate[]
  jobsWon          Job[]    @relation("JobChosenContractor")
  reviews          Review[]
}

model Job {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title       String
  description String

  pickupAddressLine1 String
  pickupAddressLine2 String?
  city               String
  state              String
  zip                String
  pickupDate         DateTime

  // Geocoded from the pickup address when the job is created (best-effort --
  // see lib/geocode.ts). Powers the GPS arrival check below; null if
  // geocoding failed or hasn't run.
  latitude  Float?
  longitude Float?

  status              JobStatus @default(DRAFT)
  chosenContractorId  String?
  chosenContractor    Contractor? @relation("JobChosenContractor", fields: [chosenContractorId], references: [id])

  // 45-minute contractor timing + GPS arrival verification (see lib/timing.ts).
  // startedAt begins the clock; arrivedAt/arrivalLat/arrivalLng/arrivalVerified
  // are set together when the contractor confirms arrival.
  startedAt        DateTime?
  arrivedAt        DateTime?
  arrivalLat       Float?
  arrivalLng       Float?
  arrivalVerified  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos    JobPhoto[]
  estimates Estimate[]
  payment   Payment?
  review    Review?

  @@index([customerId])
  @@index([status])
}

model JobPhoto {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Object key in the JOB_PHOTOS R2 bucket (see lib/r2.ts). Served back
  // through /api/photos/[...key] rather than a public bucket URL.
  r2Key       String   @db.Text
  contentType String
  caption     String?
  createdAt   DateTime @default(now())

  @@index([jobId])
}

model Estimate {
  id           String         @id @default(cuid())
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contractorId String
  contractor   Contractor     @relation(fields: [contractorId], references: [id])

  amountCents  Int
  message      String?
  status       EstimateStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([contractorId])
}

model Payment {
  id                    String        @id @default(cuid())
  jobId                 String        @unique
  job                   Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  stripePaymentIntentId String        @unique
  amountCents           Int
  status                PaymentStatus @default(PENDING)
  receiptUrl            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id           String   @id @default(cuid())
  jobId        String   @unique
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now())

  @@index([contractorId])
}
