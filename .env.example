# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored -- never commit real secrets.

# --- Clerk (Dashboard > API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database (Neon Postgres connection string, from the Neon dashboard) ---
DATABASE_URL=

# --- Stripe (Dashboard > Developers > API keys; use test keys while developing) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard > Developers > Webhooks > Add endpoint (see README for the exact URL/events)
STRIPE_WEBHOOK_SECRET=
